{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/generate-image",
      "dest": "/api/generate_image.py"
    },
    {
      "src": "/api/generate_image",
      "dest": "/api/generate_image.py"
    },
    {
      "src": "/api/analyze-code",
      "dest": "/api/analyze_code.py"
    },
    {
      "src": "/api/analyze_code",
      "dest": "/api/analyze_code.py"
    },
    {
      "src": "/api/generate-sound",
      "dest": "/api/generate_sound.py"
    },
    {
      "src": "/api/generate_sound",
      "dest": "/api/generate_sound.py"
    },
    {
      "src": "/games/(.*)",
      "dest": "/games/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}